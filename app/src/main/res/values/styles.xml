<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">0.92</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.URLoader.Button.Primary" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.URLoader.Button.Gradient" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_gemini_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:elevation">8dp</item>
        <item name="elevation">8dp</item>
        <item name="android:outlineSpotShadowColor">@color/gemini_gradient_start</item>
        <item name="android:outlineAmbientShadowColor">@color/gemini_gradient_middle</item>
    </style>

    <style name="Widget.URLoader.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
    </style>

    <style name="Widget.URLoader.Button.Soft" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
    </style>
</resources>
