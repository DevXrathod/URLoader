<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/gemini_stroke_start"
                android:centerColor="@color/gemini_stroke_mid"
                android:endColor="@color/gemini_stroke_end"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface_variant" />
        </shape>
    </item>
</layer-list>
